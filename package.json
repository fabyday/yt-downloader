{
  "name": "yt-section-downloader",
  "version": "0.1.0",
  "description": "Electron app for previewing YouTube videos and downloading selected clips.",
  "main": "src/main/main.cjs",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "keywords": [
    "electron",
    "youtube",
    "yt-dlp",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.ytdownloader.app",
    "productName": "YT Section Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "thirdparty/bin",
        "to": "thirdparty/bin"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3"
  }
}
