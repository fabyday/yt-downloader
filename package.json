{
  "name": "yt-section-downloader",
  "version": "0.1.0",
  "description": "Electron app for previewing videos supported by yt-dlp and downloading selected clips.",
  "main": "build/main/main.js",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "kawai-ui:check": "node scripts/check-ui.cjs",
    "typecheck": "pnpm run kawai-ui:check && tsc --noEmit",
    "bundle": "pnpm run bundle:prod",
    "bundle:prod": "pnpm run kawai-ui:check && webpack --config src/Main/webpack.prod.ts src/Preload/webpack.prod.ts src/Renderer/webpack.prod.ts src/Worker/webpack.prod.ts",
    "bundle:dev": "pnpm run kawai-ui:check && webpack --config src/Main/webpack.dev.ts src/Preload/webpack.dev.ts src/Renderer/webpack.dev.ts src/Worker/webpack.dev.ts",
    "bundle:main:prod": "webpack --config src/Main/webpack.prod.ts",
    "bundle:main:dev": "webpack --config src/Main/webpack.dev.ts",
    "bundle:preload:prod": "webpack --config src/Preload/webpack.prod.ts",
    "bundle:preload:dev": "webpack --config src/Preload/webpack.dev.ts",
    "bundle:renderer:prod": "pnpm run kawai-ui:check && webpack --config src/Renderer/webpack.prod.ts",
    "bundle:renderer:dev": "pnpm run kawai-ui:check && webpack --config src/Renderer/webpack.dev.ts",
    "bundle:worker:prod": "webpack --config src/Worker/webpack.prod.ts",
    "bundle:worker:dev": "webpack --config src/Worker/webpack.dev.ts",
    "test:worker": "pnpm run bundle:worker:dev && node tests/worker-integration.cjs",
    "test:protocol": "node --require ts-node/register/transpile-only --test tests/external-protocol.test.cjs",
    "test:updater": "node --require ts-node/register/transpile-only --test tests/yt-dlp-updater.test.cjs",
    "test:cookies": "node --require ts-node/register/transpile-only --test tests/cookies.test.cjs",
    "test:sites": "node --require ts-node/register/transpile-only --test tests/multi-site.test.cjs tests/preview-resolver.test.cjs tests/cookies.test.cjs",
    "test:windows": "node --require ts-node/register/transpile-only --test tests/window-chrome.test.cjs",
    "dev": "pnpm run binaries:prepare && pnpm run bundle:dev && electron .",
    "start": "pnpm run dev",
    "start:connected": "node scripts/start-connected.cjs",
    "dev:server": "node scripts/serve-distribution.cjs",
    "distribution:serve": "node scripts/serve-distribution.cjs",
    "dev:server:build": "pnpm build && pnpm dev:server",
    "test:dev-server": "node --test tests/distribution-server.test.cjs",
    "watch": "pnpm run kawai-ui:check && webpack --config src/Main/webpack.dev.ts src/Preload/webpack.dev.ts src/Renderer/webpack.dev.ts src/Worker/webpack.dev.ts --watch",
    "build": "node scripts/build.cjs",
    "build:win": "node scripts/build.cjs --platform win32 --arch x64",
    "build:win:x64": "node scripts/build.cjs --platform win32 --arch x64",
    "build:win:arm64": "node scripts/build.cjs --platform win32 --arch arm64",
    "build:mac": "node scripts/build.cjs --platform darwin",
    "build:mac:arm64": "node scripts/build.cjs --platform darwin --arch arm64",
    "build:mac:x64": "node scripts/build.cjs --platform darwin --arch x64",
    "build:dir": "node scripts/build.cjs --dir",
    "build:dir:win": "node scripts/build.cjs --platform win32 --arch x64 --dir",
    "build:dir:mac": "node scripts/build.cjs --platform darwin --dir",
    "test:build": "node --test tests/build.test.cjs tests/release.test.cjs tests/install-mac.test.cjs tests/distribution-server.test.cjs tests/start-connected.test.cjs tests/ui-dependency.test.cjs",
    "binaries:prepare": "node scripts/prepare-binaries.cjs",
    "release:manifest": "node generate-release-manifest.cjs"
  },
  "keywords": [
    "electron",
    "youtube",
    "yt-dlp",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@kawaikara/kawai-ui": "github:Kawaikara/KawaiUi#6ca5ede93e97b2484b9ddb207d0f3234bd910f18",
    "hls.js": "^1.7.3",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "day.faby.kawai-downloader",
    "productName": "kawai-downloader",
    "asarUnpack": ["build/worker/yt-dlp-plugins/**/*"],
    "protocols": [
      {
        "name": "kawai-downloader URL",
        "schemes": [
          "kawai-downloader",
          "yt-downloader"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "resources/app-icon.png",
      "build/**/*",
      "package.json",
      "kawaikara-companion.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-Portable.${ext}"
    },
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "extract-zip": "2.0.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
